{
  "compilerOptions": {
    "module":           "commonjs",
    "moduleResolution": "node",
    "target":           "es2020",
    "lib":              ["es2020"],
    "outDir":           "lib",
    "rootDir":          "src",
    "sourceMap":        true,
    "strict":           true,
    "noImplicitReturns": true,
    "noUnusedLocals":   true,
    "esModuleInterop":  true,
    "skipLibCheck":     true
  },
  "compileOnSave": true,
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
